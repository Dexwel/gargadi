# --- Database (Neon or Supabase Postgres connection string) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Admin login ---
# Generate a hash with:  npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Random 32+ char string used to sign the admin session cookie
SESSION_SECRET=

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Alert sending ---
# mock (default, nothing is sent) | twilio (real SMS + WhatsApp)
ALERT_SENDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
CRON_SECRET=
REVIEWED_LANGUAGES=en
